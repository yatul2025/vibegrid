# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Option A: Connection URI (e.g. Neon, Supabase, Render, or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vibegrid_db

# Option B: Individual connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vibegrid_db

# Authentication Secrets (Generate a long random string for production)
JWT_SECRET=vibegrid_dev_secret_key_123456789_change_me
JWT_EXPIRES_IN=7d

# Free Gmail Email OTP (2FA) Service
# Generate App Password: Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Web Push VAPID Keys (Generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@vibegrid.com

# WebRTC STUN/TURN Server Configuration
# Option 1: Coturn Self-Hosted (HMAC-SHA1 Ephemeral Auth)
TURN_SECRET=your_coturn_static_auth_secret
TURN_DOMAIN=turn.vibegrid.app
TURN_PORT=3478
TURN_TLS_PORT=5349

# Option 2: Metered.ca TURN (Free cloud TURN service)
# METERED_DOMAIN=your-app.metered.live
# METERED_API_KEY=your_metered_api_key


